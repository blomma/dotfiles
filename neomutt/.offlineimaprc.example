# Sample minimal config file.  Copy this to ~/.offlineimaprc and edit to
# get started fast.

[general]
accounts = personal,secondary
pythonfile = ~/.offlineimap.py

[Account personal]
localrepository = personal-local
remoterepository = personal-remote
postsynchook = ~/.offlineimap.postsynchook

[Repository personal-local]
type = Maildir
localfolders = ~/.mail/personal

[Repository personal-remote]
type = IMAP
ssl = yes
cert_fingerprint = BD:DC:89:DA:E4:86:29:89:8A:F1:34:21:D7:84:4F:80:6C:A3:39:43
remotehost = mail.messagingengine.com
remoteuser = user@example.com
remotepasseval = imappasswd("personal")

[Account secondary]
localrepository = secondary-local
remoterepository = secondary-remote
postsynchook = ~/.offlineimap.postsynchook

[Repository secondary-local]
type = Maildir
localfolders = ~/.mail/secondary

[Repository secondary-remote]
type = IMAP
ssl = yes
cert_fingerprint = 86:A1:FD:DE:63:09:8A:6C:AA:65:F6:E9:39:6D:A9:DC:C4:AF:5F:5D
remotehost = imap.one.com
remoteuser = user@example.com
remotepasseval = imappasswd("secondary")