# vim: ft=offlineimap
[general]
accounts = personal
pythonfile = ~/.config/offlineimap/offlineimap.py

[Account personal]
localrepository = personal-local
remoterepository = personal-remote
postsynchook = ~/.config/offlineimap/postsynchook.sh

[Repository personal-local]
type = Maildir
localfolders = ~/.mail/personal

[Repository personal-remote]
type = IMAP
ssl = yes
cert_fingerprint = 1C:12:3C:15:EB:31:16:7D:E9:2C:3C:F1:C1:5A:98:06:FA:EB:EF:0B:BB:79:FB:52:58:A5:35:2D:BD:2F:DF:09
remotehost = mail.messagingengine.com
remoteuser = user@example.com
remotepasseval = get_pass("fastmail")

